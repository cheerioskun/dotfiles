{
  "selector": "source.c++",
  "working_dir": "$file_path",
  "shell_cmd": "compiler=$(find \"$(brew --prefix gcc)/bin\" -name 'g++-*' -type f | sort -V | tail -1) && \"$compiler\" -std=c++20 -O2 -Wall -Wextra \"$file\" -o \"$file_path/main\" && \"$file_path/main\" < \"$file_path/input.txt\" > \"$file_path/output.txt\""
}
