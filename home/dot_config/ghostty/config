# Ghostty — a calm, keyboard-first terminal.
#
# The color themes live beside this file so the config stays reproducible instead
# of depending on a theme shipped by a particular Ghostty version.

theme = light:catppuccin-latte,dark:catppuccin-mocha

# Readable coding font. The macos-gui profile installs this Nerd Font so
# Powerlevel10k and other prompt glyphs render consistently.
font-family = "JetBrainsMono Nerd Font"
font-size = 14
# Avoid ligatures in code, logs, diffs, and command output.
font-feature = -calt

# Comfortable without wasting screen space.
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
window-inherit-working-directory = true
split-inherit-working-directory = true
tab-inherit-working-directory = true

# Native macOS feel, with a little translucency and blur.
window-decoration = auto
macos-titlebar-style = transparent
background-opacity = 0.96
background-blur = true
unfocused-split-opacity = 0.78

# Shell and terminal ergonomics.
shell-integration = zsh
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo,path
copy-on-select = clipboard
mouse-hide-while-typing = true
scrollback-limit = 100000000
cursor-style = bar
cursor-style-blink = false

# A fast drop-down terminal. Cmd+Option+Space may need Accessibility
# permission in System Settings > Privacy & Security > Accessibility.
quick-terminal-position = top
quick-terminal-size = 45%,100%
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15
keybind = global:cmd+alt+space=toggle_quick_terminal

# Ghostty's native macOS bindings already cover tabs, splits, split
# navigation, resizing, search, fullscreen, and config reload.
